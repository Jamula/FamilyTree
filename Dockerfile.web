# Local-only fictional landing page. Do not host personal genealogy records.
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /source
COPY Directory.Build.props global.json ./
COPY src/ ./src/
RUN dotnet restore src/FamilyTree.Web/FamilyTree.Web.csproj
RUN dotnet publish src/FamilyTree.Web/FamilyTree.Web.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:11.0
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "FamilyTree.Web.dll"]
